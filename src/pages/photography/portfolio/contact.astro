---
import PhotographyLayout from '../../../layouts/PhotographyLayout.astro';
---

<PhotographyLayout
  title="Contact & Booking · Ashton Sprunger Photography"
  description="Inquire about senior portraits, family sessions, or creative portrait photography in Fort Wayne, Indiana."
>
  <div class="py-12 md:py-20 bg-[#fafafa]">
    <div class="mx-auto max-w-4xl px-6">
      
      <!-- Back Link & Header -->
      <div class="mb-10 text-center md:text-left">
        <a
          href="/photography/portfolio"
          class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-500 hover:text-neutral-900 transition-colors mb-6 no-underline"
        >
          <span>&larr;</span> Back to Portfolio
        </a>
        <span class="block font-mono text-xs uppercase tracking-widest text-neutral-500 font-semibold">
          Fort Wayne, Indiana · Session Inquiries
        </span>
        <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-neutral-900">
          Book a Session or Get in Touch
        </h1>
        <p class="mt-3 text-sm text-neutral-600 max-w-2xl">
          Fill out the inquiry form below with your graduation timeline, family ideas, or preferred outdoor locations in Fort Wayne. I'll get back to you within 24–48 hours.
        </p>
      </div>

      <!-- Google Form Embed Container -->
      <div class="w-full overflow-hidden rounded-3xl border border-neutral-200/80 bg-white shadow-lg p-2 sm:p-6">
        <iframe
          src="https://docs.google.com/forms/d/e/1FAIpQLSet6Wsi6G6O_V6Tf38ngMIFTuuKGyLbrrSA-ne9wcqbUbQF-w/viewform?embedded=true"
          width="100%"
          height="1500"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          class="w-full min-h-[1400px] border-0"
          title="Contact & Session Booking Form"
        >
          Loading form…
        </iframe>
      </div>

      <!-- Quick Alternative Contact -->
      <div class="mt-12 text-center text-xs font-mono text-neutral-500 space-y-2">
        <p>
          Prefer direct email? Reach out anytime at <a href="mailto:sprungerashton@gmail.com" class="text-neutral-900 underline font-semibold">sprungerashton@gmail.com</a>
        </p>
        <p>
          <a href="https://www.facebook.com/profile.php?id=100086326337312" target="_blank" rel="noopener noreferrer" class="text-neutral-700 hover:text-neutral-900 underline">
            Message on Facebook &rarr;
          </a>
        </p>
      </div>

    </div>
  </div>
</PhotographyLayout>
