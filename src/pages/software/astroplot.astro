    <script is:inline>
      (function() {
        function fallbackCopy(text, cb) {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.focus();
          ta.select();
          try { document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(ta);
          if (cb) cb();
        }

        // 1. Copy Email Button Handler
        const copyBtn = document.getElementById('copyEmailBtn');
        if (copyBtn) {
          copyBtn.addEventListener('click', () => {
            const email = 'sprungerashton@gmail.com';
            const textSpan = document.getElementById('copyBtnText');
            const done = () => {
              if (textSpan) textSpan.textContent = 'Copied!';
              copyBtn.classList.add('copied');
              setTimeout(() => {
                if (textSpan) textSpan.textContent = 'Copy';
                copyBtn.classList.remove('copied');
              }, 2000);
            };
            if (navigator.clipboard && window.isSecureContext) {
              navigator.clipboard.writeText(email).then(done).catch(() => fallbackCopy(email, done));
            } else {
              fallbackCopy(email, done);
            }
          });
        }

        // 2. macOS Waitlist Modal Handler
        const modal = document.getElementById('macosModal');
        const closeBtn = document.getElementById('closeMacosModalBtn');
        const macCopyBtn = document.getElementById('macCopyEmailBtn');
        const macCopyText = document.getElementById('macCopyText');

        function openMacosModal(e) {
          if (e && typeof e.preventDefault === 'function') e.preventDefault();
          if (!modal) return;
          modal.removeAttribute('hidden');
          void modal.offsetWidth;
          modal.classList.add('visible');
          document.body.style.overflow = 'hidden';
        }

        function closeMacosModal() {
          if (!modal) return;
          modal.classList.remove('visible');
          setTimeout(() => {
            modal.setAttribute('hidden', '');
          }, 250);
          document.body.style.overflow = '';
        }

        if (closeBtn) {
          closeBtn.addEventListener('click', closeMacosModal);
        }
        if (modal) {
          modal.addEventListener('click', (e) => {
            if (e.target === modal) closeMacosModal();
          });
        }

        if (macCopyBtn && macCopyText) {
          macCopyBtn.addEventListener('click', () => {
            const email = 'sprungerashton@gmail.com';
            const originalText = macCopyText.textContent;
            const onCopied = () => {
              macCopyText.textContent = '✓ Copied sprungerashton@gmail.com!';
              macCopyBtn.classList.add('copied');
              setTimeout(() => {
                macCopyText.textContent = originalText;
                macCopyBtn.classList.remove('copied');
              }, 2500);
            };
            if (navigator.clipboard && window.isSecureContext) {
              navigator.clipboard.writeText(email).then(onCopied).catch(() => fallbackCopy(email, onCopied));
            } else {
              fallbackCopy(email, onCopied);
            }
          });
        }

        // Attach click to all waitlist triggers
        document.querySelectorAll('.macos-waitlist-trigger, .spec-macos-link').forEach(trigger => {
          trigger.addEventListener('click', openMacosModal);
        });

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && modal && !modal.hasAttribute('hidden')) {
            closeMacosModal();
          }
        });

        // Detect macOS visitors
        function isMacOS() {
          if (typeof navigator === 'undefined') return false;
          if (navigator.userAgentData && navigator.userAgentData.platform) {
            return /mac/i.test(navigator.userAgentData.platform);
          }
          return /Macintosh|Mac OS X|MacIntel|MacPPC/i.test(navigator.userAgent || navigator.platform || '');
        }

        if (isMacOS()) {
          document.querySelectorAll('a.btn-download-trial:not(.btn-download-channel)').forEach(el => {
            el.removeAttribute('download');
            el.href = 'mailto:sprungerashton@gmail.com?subject=AstroPlot%20RAW%20macOS%20Waitlist&body=Hi%20Ashton,%20please%20notify%20me%20when%20the%20macOS%20version%20of%20AstroPlot%20RAW%20is%20ready!';
            el.classList.add('macos-waitlist-trigger');
            el.addEventListener('click', openMacosModal);
            if (el.textContent.includes('Download Free Trial') || el.textContent.includes('Trial')) {
              el.textContent = 'Join macOS Waitlist';
            }
          });
        }
      })();
    </script>
