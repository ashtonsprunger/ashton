---
import '../../../styles/global.css';

const downloadUrl = "https://github.com/ashtonsprunger/astroplot-releases/releases/download/v1.5.1/AstroPlot.RAW_1.5.1_x64-setup.exe";
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/astroplot/app-icon.png" />
    <title>Privacy Policy | AstroPlot RAW</title>
    <meta name="description" content="Privacy Policy for AstroPlot RAW." />
    <meta name="author" content="Ashton Sprunger" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body class="bg-[#07090e] text-[#f8fafc] antialiased min-h-screen flex flex-col font-['Inter',sans-serif] selection:bg-[#00FFFF]/20 selection:text-[#00FFFF]">
    <!-- Ambient space glow -->
    <div class="fixed inset-0 -z-10 pointer-events-none overflow-hidden">
      <div class="absolute -top-[10%] left-1/2 -translate-x-1/2 h-[500px] w-[900px] rounded-full bg-[#0e2244]/40 blur-[130px]"></div>
    </div>

    <!-- Header -->
    <header class="sticky top-0 z-50 w-full border-b border-[#00FFFF]/20 bg-[#090d16]/90 backdrop-blur-md shadow-lg">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-3.5">
        <div class="flex items-center gap-4">
          <a href="/software/astroplot" class="flex items-center gap-2.5 no-underline font-bold text-base text-white hover:text-white">
            <img src="/astroplot/app-icon.png" alt="AstroPlot RAW Logo" class="h-7 w-7 rounded-md shadow-sm" />
            <span class="tracking-tight">AstroPlot RAW</span>
          </a>
          <a
            href="/"
            class="hidden sm:inline-flex items-center gap-1 rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 font-mono text-[11px] text-neutral-400 no-underline hover:text-white hover:border-white/20 transition-all"
          >
            <span>&larr; ashtonsprunger.com</span>
          </a>
        </div>

        <nav class="hidden md:flex items-center gap-6 text-xs font-mono font-medium text-neutral-400">
          <a href="/software/astroplot" class="no-underline hover:text-white transition-colors">Home</a>
          <a href="/software/astroplot/blog/" class="no-underline hover:text-white transition-colors">Guides</a>
          <a href="/software/astroplot#pricing" class="no-underline hover:text-white transition-colors">Pricing &amp; Options</a>
          <a href="/software/astroplot/terms" class="no-underline hover:text-white transition-colors">Terms</a>
          <a href="/software/astroplot#contact" class="no-underline hover:text-white transition-colors">Contact</a>
          <a
            href={downloadUrl}
            class="rounded-lg bg-[#00FFFF] px-3.5 py-1.5 font-bold text-black no-underline hover:bg-[#33ffff] transition-all shadow-sm"
            download
          >
            Download Free Trial
          </a>
        </nav>

        <div class="flex md:hidden">
          <a
            href={downloadUrl}
            class="rounded-lg bg-[#00FFFF] px-3 py-1 font-mono text-xs font-bold text-black no-underline"
            download
          >
            Download
          </a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-6 py-16 md:py-24 flex-1 w-full">
      <div class="mb-10">
        <span class="font-mono text-xs uppercase tracking-widest text-[#00FFFF] font-semibold">Policy</span>
        <h1 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-white">Privacy Policy</h1>
        <p class="mt-3 text-sm text-neutral-400 font-sans">
          Last updated: 2026. Local-first software designed with zero data collection.
        </p>
      </div>

      <div class="space-y-6">
        <div class="rounded-2xl border border-white/10 bg-[#101726] p-6 sm:p-8">
          <ol class="space-y-6 font-sans text-sm text-neutral-300">
            <li class="flex items-start gap-4">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#00FFFF]/15 border border-[#00FFFF]/40 font-mono text-xs font-bold text-[#00FFFF]">
                1
              </span>
              <div>
                <strong class="text-white block mb-1 text-base">Zero Data Collection</strong>
                <span>AstroPlot RAW operates 100% locally on your computer. We do not collect, store, or transmit your photos, EXIF metadata, telemetry, or usage analytics.</span>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#00FFFF]/15 border border-[#00FFFF]/40 font-mono text-xs font-bold text-[#00FFFF]">
                2
              </span>
              <div>
                <strong class="text-white block mb-1 text-base">Local Trial &amp; License Validation</strong>
                <span>14-day evaluation trial tracking and perpetual license validation are stored strictly on your local device. There is zero background phone-home telemetry or online tracking of your sessions.</span>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#00FFFF]/15 border border-[#00FFFF]/40 font-mono text-xs font-bold text-[#00FFFF]">
                3
              </span>
              <div>
                <strong class="text-white block mb-1 text-base">Payments &amp; Licensing</strong>
                <span>All purchases are processed securely by LemonSqueezy or the Microsoft Store. We never receive or store your credit card or billing information.</span>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-neutral-800 bg-[#05070a] py-8 text-neutral-500 text-xs font-mono">
      <div class="mx-auto max-w-5xl px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          &copy; {new Date().getFullYear()} AstroPlot Software by Ashton Sprunger &bull; <a href="/software/astroplot/blog/" class="hover:text-white transition-colors">Guides</a> &bull; <a href="/software/astroplot#contact" class="hover:text-white transition-colors">Contact</a> &bull; <a href="/software/astroplot/privacy" class="text-white underline">Privacy Policy</a> &bull; <a href="/software/astroplot/terms" class="hover:text-white transition-colors">Terms</a>
        </div>
        <div class="flex items-center gap-4">
          <a href="/" class="hover:text-white transition-colors">&larr; ashtonsprunger.com</a>
        </div>
      </div>
    </footer>
  </body>
</html>
