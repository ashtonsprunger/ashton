                </a>
                <span class="text-[10px] text-neutral-500 block text-center">Apple Silicon &amp; Intel &bull; Free trial on launch</span>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-neutral-800 bg-[#05070a] py-8 text-neutral-500 text-xs font-mono">
      <div class="mx-auto max-w-5xl px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          &copy; {new Date().getFullYear()} AstroPlot Software by Ashton Sprunger &bull; <a href="/software/astroplot/blog" class="text-neutral-400 hover:text-white transition-colors">Guides</a> &bull; <a href="/software/astroplot#contact" class="hover:text-white transition-colors">Contact</a> &bull; <a href="/software/astroplot/privacy" class="hover:text-white transition-colors">Privacy Policy</a> &bull; <a href="/software/astroplot/terms" class="hover:text-white transition-colors">Terms</a>
