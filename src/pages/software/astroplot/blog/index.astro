    <style>
      .macos-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 10000;
        background: rgba(5, 8, 15, 0.82);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s ease, visibility 0.25s ease;
      }
      .macos-modal-backdrop.visible {
        opacity: 1;
        visibility: visible;
      }
      .macos-modal-backdrop[hidden] {
        display: none !important;
      }
      .macos-modal-dialog {
