        transition: all 0.2s ease;
        width: 100%;
        box-sizing: border-box;
      }
      .macos-action-gmail {
        background: rgba(234, 67, 53, 0.12);
        border: 1px solid rgba(234, 67, 53, 0.45);
        color: #fca5a5;
      }
      .macos-action-gmail:hover {
        background: rgba(234, 67, 53, 0.24);
        color: #fff;
        border-color: rgba(234, 67, 53, 0.65);
      }
      .macos-action-client {
        background: rgba(0, 255, 255, 0.1);
        border: 1px solid rgba(0, 255, 255, 0.45);
        color: #00FFFF;
      }
      .macos-action-client:hover {
        background: rgba(0, 255, 255, 0.2);
        color: #fff;
        border-color: #00FFFF;
      }
      .macos-action-copy {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #e2e8f0;
      }
      .macos-action-copy:hover {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        border-color: rgba(255, 255, 255, 0.3);
      }
      .macos-action-copy.copied {
        background: rgba(0, 255, 255, 0.18);
        border-color: #00FFFF;
        color: #00FFFF;
      }
      .macos-modal-footer {
        font-size: 0.775rem;
        color: #64748b;
        font-family: 'JetBrains Mono', monospace;
        line-height: 1.4;
      }

      /* Download Feedback Toast Notification */
      .download-toast {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        max-width: 440px;
        background: rgba(13, 19, 31, 0.97);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(0, 255, 255, 0.5);
        border-radius: 12px;
        padding: 1.25rem 1.25rem 1.25rem 1.4rem;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7), 0 0 24px rgba(0, 255, 255, 0.2);
        z-index: 9999;
        display: flex;
        gap: 1rem;
        align-items: flex-start;
        opacity: 0;
        visibility: hidden;
        transform: translateY(24px) scale(0.96);
        transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s;
        pointer-events: none;
      }
      .download-toast.visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
        pointer-events: auto;
      }
      .download-toast-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(0, 255, 255, 0.15);
        color: #00FFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 2px;
      }
      .download-toast-content {
        flex: 1;
      }
      .download-toast-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 0.25rem;
      }
      .download-toast-desc {
        font-size: 0.85rem;
        color: #94a3b8;
        line-height: 1.45;
        margin-bottom: 0.75rem;
      }
      .download-toast-desc code {
        font-family: 'JetBrains Mono', monospace;
        background: rgba(0, 255, 255, 0.1);
        color: #00FFFF;
        padding: 1px 4px;
        border-radius: 3px;
      }
      .download-toast-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.85rem;
        font-size: 0.825rem;
      }
      .download-toast-link {
        color: #00FFFF;
        text-decoration: underline;
        cursor: pointer;
        font-weight: 500;
      }
      .download-toast-link:hover {
        color: #fff;
      }
      .download-toast-close {
        background: none;
        border: none;
        color: #64748b;
        cursor: pointer;
        padding: 4px 6px;
        font-size: 1.35rem;
        line-height: 1;
        border-radius: 4px;
        transition: color 0.15s ease, background-color 0.15s ease;
      }
      .download-toast-close:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.08);
      }
      @media (max-width: 600px) {
        .download-toast {
          bottom: 1rem;
          left: 1rem;
          right: 1rem;
          max-width: none;
        }
      }
    </style>

    <script is:inline>
      (function() {
        function fallbackCopy(text, cb) {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.focus();
          ta.select();
          try { document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(ta);
          if (cb) cb();
        }

        // macOS Modal Logic
        const modal = document.getElementById('macosModal');
        const closeBtn = document.getElementById('closeMacosModalBtn');
        const macCopyBtn = document.getElementById('macCopyEmailBtn');
        const macCopyText = document.getElementById('macCopyText');

        function openMacosModal(e) {
          if (e) e.preventDefault();
          if (modal) {
            modal.removeAttribute('hidden');
            requestAnimationFrame(() => modal.classList.add('visible'));
          }
        }

        function closeMacosModal() {
          if (modal) {
            modal.classList.remove('visible');
            setTimeout(() => modal.setAttribute('hidden', ''), 250);
          }
        }

        if (closeBtn) closeBtn.addEventListener('click', closeMacosModal);
        if (modal) {
          modal.addEventListener('click', (e) => {
            if (e.target === modal) closeMacosModal();
          });
        }

        if (macCopyBtn && macCopyText) {
          macCopyBtn.addEventListener('click', () => {
            const email = 'sprungerashton@gmail.com';
            const originalText = macCopyText.textContent;
            const onCopied = () => {
              macCopyText.textContent = '✓ Copied sprungerashton@gmail.com!';
              macCopyBtn.classList.add('copied');
              setTimeout(() => {
                macCopyText.textContent = originalText;
                macCopyBtn.classList.remove('copied');
              }, 2500);
            };
            if (navigator.clipboard && window.isSecureContext) {
              navigator.clipboard.writeText(email).then(onCopied).catch(() => fallbackCopy(email, onCopied));
            } else {
              fallbackCopy(email, onCopied);
            }
          });
        }

        document.querySelectorAll('.macos-waitlist-trigger').forEach(trigger => {
          trigger.addEventListener('click', openMacosModal);
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && modal && !modal.hasAttribute('hidden')) {
            closeMacosModal();
          }
        });
      })();
    </script>
    <script is:inline src="/software/astroplot/download-handler.js"></script>
  </body>
</html>
