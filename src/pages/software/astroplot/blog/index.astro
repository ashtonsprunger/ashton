                </a>
                <span class="text-[10px] text-neutral-500 block text-center">Full app · Includes 14-day free trial</span>
              </div>
            </div>

            <!-- macOS Channel -->
            <div class="rounded-2xl border border-white/10 bg-[#0b101c] p-6 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="font-bold text-sm text-white">macOS</span>
                  <span class="rounded bg-amber-500/10 text-amber-400 border border-amber-500/30 px-2 py-0.5 text-[10px]">
