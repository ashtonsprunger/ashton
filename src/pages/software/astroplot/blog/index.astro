        </div>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-6 flex-1 w-full py-12 md:py-16">
      <!-- Breadcrumb -->
      <div class="mb-8">
        <a href="/software/astroplot" class="inline-flex items-center gap-2 font-mono text-xs text-neutral-400 no-underline hover:text-[#00FFFF] transition-colors">
          <span>&larr; Back to AstroPlot RAW</span>
        </a>
