<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Astrophotography Workflow &amp; RAW Calibration Guides | AstroPlot RAW</title>
    <meta name="description" content="In-depth, no-fluff technical guides for astrophotographers: pre-sorting DSLR RAW files for Siril scripts, detecting ruined frames on 2D scatter plots, and DeepSkyStacker vs Siril comparison." />
    <meta name="keywords" content="astrophotography guides, Siril workflow, cull bad subs, DeepSkyStacker vs Siril, astrophotography pre-sorting, astro raw organization" />
    <meta name="author" content="Ashton Sprunger" />
    <link rel="canonical" href="https://ashtonsprunger.com/software/astroplot/blog" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Astrophotography Workflow &amp; RAW Calibration Guides" />
    <meta property="og:description" content="Step-by-step guides for pre-sorting DSLR exposures, culling ruined frames, and stacking with Siril &amp; DeepSkyStacker." />
    <meta property="og:url" content="https://ashtonsprunger.com/software/astroplot/blog" />
    <meta property="og:site_name" content="AstroPlot RAW" />
