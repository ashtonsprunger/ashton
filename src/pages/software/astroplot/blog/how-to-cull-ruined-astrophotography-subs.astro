                    <th class="px-4 py-3 font-semibold">Action Required</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                  <tr class="hover:bg-white/[0.02]">
                    <td class="px-4 py-3.5 font-bold text-white">High Clouds &amp; Haze</td>
