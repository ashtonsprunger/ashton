---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ashton Sprunger",
  description = "Personal site of Ashton Sprunger — software, photography, music."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body class="bg-[#111111] text-[#d4d4d4] antialiased">
    <div class="mx-auto max-w-2xl px-6 min-h-screen flex flex-col justify-between">
      <div>
        <Header />
        <main>
          <slot />
        </main>
      </div>
      <Footer />
    </div>
  </body>
</html>
